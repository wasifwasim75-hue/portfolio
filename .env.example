# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your local MongoDB URI or MongoDB Atlas URI.
# If empty or unreachable in development, an in-memory MongoDB instance will seamlessly boot up!
MONGODB_URI=mongodb://localhost:27017/portfolio

# Authentication & Security
JWT_SECRET=super_secure_jwt_secret_dev_key_portfolio_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
